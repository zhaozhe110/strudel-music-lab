// 袖珍电路 / LITTLE LOGIC
// 原创致敬 Kraftwerk《Pocket Calculator》的器乐作品
// 126 BPM · E major · 64 小节，约 2 分 02 秒后整曲循环
// 所有音色现场合成，无需加载外部采样。
// 修改最下面的 arrange(...) 可以重新编排整首曲子。
// 播放后可视化显示在这里，下方依次是音符图和波形。
// 颜色：黄＝旋律，青＝贝斯，绿＝按键，紫＝和声，灰＝鼓。
// 这个函数写在顶部，图就显示在顶部；整曲写完后才调用。
const showVisuals = p => {
  p.gain(.85)._pianoroll({
    width: 760, height: 210, cycles: 4, playhead: .25,
    fold: 1, labels: 1, fill: 1, fillActive: 1,
    colorizeInactive: 1, playheadColor: '#ffe45c', background: '#08110d'
  })
  return p._scope({ width: 760, height: 75, thickness: 2, scale: .9 })
}

setcpm(126/4)

// —— 鼓：低频正弦脉冲、短噪声军鼓、细细的踩镲 ——
const kick = note("e1*4").sound("sine")
  .penv(30).panchor(0).pattack(0).pdecay(.045).psustain(0)
  .attack(.002).decay(.16).sustain(0).release(.035).gain(.72).color("#8b99aa")

const snare = stack(
  sound("~ white ~ white").hpf(1200).lpf(6800)
    .attack(.001).decay(.075).sustain(0).release(.025).gain(.23),
  note("~ e3 ~ e3").sound("triangle")
    .penv(7).pattack(0).pdecay(.025).psustain(0)
    .attack(.001).decay(.065).sustain(0).release(.02).gain(.18)
).color("#8b99aa")

const hats = sound("white*8").hpf(7200).lpf(12500)
  .attack(.001).decay(.025).sustain(0).release(.009)
  .gain("[.08 .13]*4").pan(.58).color("#8b99aa")

const tick = note("~ b5 ~ [~ e6]").sound("sine")
  .attack(.001).decay(.018).sustain(0).release(.008)
  .gain(.1).pan(.27).color("#8b99aa")

const drums = stack(kick, snare, hats, tick)

// —— 贝斯：规律中带一点切分，E → E → A → B ——
const bassNotes = note(`<
  [e2 e2 ~ b2 ~ e2 e3 b1]
  [e2 ~ b1 e2 b2 ~ e2 f#2]
  [a1 a1 ~ e2 ~ a1 a2 e2]
  [b1 ~ f#2 b1 ~ b2 f#2 d#2]
>`)

const bridgeBassNotes = note(`<
  [a1 a1 ~ e2 ~ a1 a2 e2]
  [a1 ~ e2 a1 c#2 ~ e2 c#2]
  [e2 e2 ~ b2 ~ e2 e3 b1]
  [e2 ~ b1 e2 b2 ~ e2 g#2]
  [f#2 f#2 ~ c#3 ~ f#2 a2 c#2]
  [f#2 ~ c#2 f#2 a2 ~ f#2 a2]
  [b1 b1 ~ f#2 ~ b1 b2 f#2]
  [b1 ~ f#2 b1 d#2 ~ f#2 b1]
>`)

const bassVoice = p => p.sound("square").lpf(480).lpq(.8)
  .lpenv(1.4).lpa(.002).lpd(.085).lps(0)
  .attack(.003).decay(.14).sustain(.08).release(.035)
  .clip(.65).gain(.32).color("#53dfed")
const bass = bassVoice(bassNotes)
const bridgeBass = bassVoice(bridgeBassNotes)

// —— 主旋律：八小节问答；空拍也是旋律的一部分 ——
const hookNotes = note(`<
  [~ g#4 e4 ~ b4 g#4 f#4 ~]
  [e4 ~ b3 c#4 ~ e4 f#4 b3]
  [~ a4 e4 ~ c#5 a4 g#4 e4]
  [f#4 ~ d#4 f#4 b4@2 ~@2]
  [~ g#4 e4 ~ b4 g#4 f#4 ~]
  [e4 b3 c#4 ~ e4 f#4 g#4 ~]
  [a4 ~ g#4 e4 c#4 e4 f#4 ~]
  [d#4 f#4 b4 ~ g#4 f#4 e4@2]
>`)

const bridgeNotes = note(`<
  [c#4 e4 a4 ~ g#4 e4 c#4 ~]
  [b3 c#4 e4 ~ a4@2 ~@2]
  [b3 e4 g#4 ~ f#4 e4 b3 ~]
  [g#3 b3 e4 ~ g#4@2 ~@2]
  [a3 c#4 f#4 ~ e4 c#4 a3 ~]
  [c#4 f#4 a4 ~ g#4 f#4 e4 ~]
  [d#4 f#4 b4 ~ a4 f#4 d#4 ~]
  [b3 d#4 f#4 a4 g#4 f#4 e4 ~]
>`)

const leadVoice = p => p.sound("square")
  .lpf(3100).lpq(.6).attack(.004).decay(.09)
  .sustain(.22).release(.045).clip(.62)
  .delay(.1).delaysync(1/8).delayfeedback(.16)
  .gain(.19).pan(.46).orbit(1).color("#ffe45c")
const hook = leadVoice(hookNotes)
const bridge = leadVoice(bridgeNotes).sound("triangle").gain(.24).lpf(2600)

// —— 按键回答：只在主旋律的空隙里闪一下 ——
const answer = note(`<
  [~@3 b5 ~@3 e6]
  [~ g#5 ~@2 b5 ~@3]
  [~@3 e6 ~@4]
  [~@6 f#6 d#6]
  [~@3 b5 ~@3 e6]
  [~@3 b5 ~@3 e6]
  [~@1 e6 ~@5 c#6]
  [~@3 f#6 ~@4]
>`).sound("triangle").lpf(4700)
  .attack(.001).decay(.055).sustain(0).release(.025)
  .gain(.15).pan(.7).orbit(2).color("#9bff7a")

// 更小、更干的双音节“滴-嘟”，用于开机、间奏和尾奏
const keys = note(`<
  [e6 ~ ~ b5 ~ ~ g#5 ~]
  [~ b5 e6 ~ ~ g#5 ~ b5]
  [a5 ~ ~ e6 ~ ~ c#6 ~]
  [~ f#6 d#6 ~ b5 ~ ~ ~]
>`).sound("sine").lpf(6500)
  .attack(.001).decay(.04).sustain(0).release(.016)
  .gain(.16).pan(".25 .75 .4 .6").orbit(3).color("#9bff7a")

// 稀疏的双音和声，只在部分段落加入
const harmony = note("<[g#3,b3] [g#3,c#4] [a3,c#4] [f#3,d#4]>")
  .struct("~ 1 ~ ~").sound("triangle").lpf(1700)
  .attack(.006).decay(.18).sustain(0).release(.05)
  .gain(.12).pan(.34).color("#bda1ff")

const bridgeHarmony = note("<[a3,c#4]!2 [g#3,b3]!2 [a3,c#4]!2 [f#3,d#4]!2>")
  .struct("~ 1 ~ ~").sound("triangle").lpf(1700)
  .attack(.006).decay(.18).sustain(0).release(.05)
  .gain(.12).pan(.34).color("#bda1ff")

// 关机的三个音：最后落在 E，接两小节留白
const shutdown = note("<[e6 ~ b5 ~ ~@4] [e5 ~@7]>")
  .sound("sine").attack(.002).decay(.09).sustain(0).release(.04)
  .gain(.13).pan(.5).orbit(3).color("#9bff7a")

// —— 整曲编排：每个数字是这一段持续的小节数 ——
const song = arrange(
  [4, stack(hats, keys)],                         // 00:00 开机
  [4, stack(kick, hats, bass, keys)],              // 00:08 节拍进入
  [8, stack(drums, bass, hook)],                   // 00:15 主题第一次
  [8, stack(drums, bass, hook, answer, harmony)],  // 00:30 加入按键回答
  [8, stack(drums, bridgeBass, bridge, bridgeHarmony)], // 00:46 B 段
  [4, stack(hats, tick, keys)],                    // 01:01 按键间奏
  [4, stack(kick, hats, bass, keys)],              // 01:09 重新接通
  [8, stack(drums, bass, hook, answer, harmony)],  // 01:16 主题回归
  [8, stack(drums, bass, hook.lpf(4000), answer, harmony)], // 01:31 旋律更亮一点
  [4, stack(kick, hats, bass, keys)],              // 01:47 逐层退出
  [2, shutdown],                                 // 01:54 最后的按键声
  [2, silence]                                   // 01:58 留白，然后循环
)
// 在顶部的面板显示完整编排；画图副本的亮度不改变播放音量。
showVisuals(song)
