// "天台晚风 v2" — real-guitar / acoustic-kit edition
// 保留第一版的旋律与段落；换真实拨弦、真鼓和更短的空间效果。
// 本地采样已放在 music/strudel/website/public/rooftop-v2。
// 点击 play；第一次会先解码本地采样，稍候几秒再开始演奏。
await samples('http://127.0.0.1:3009/rooftop-v2/samples.json');
const warm = await (await fetch('http://127.0.0.1:3009/rooftop-v2/preload.json')).json();
await Promise.all(warm.map(url => loadBuffer(url, getAudioContext())));
const BPM = 132;
const MASTER = 0.72;
setcpm(BPM / 4);

// 每个音有四次不同拨弦录音；允许相邻音的尾音自然重叠。
const left = note(`<
  [d3 a3 e4 fs4 a4 fs4 e4 a3]
  [fs3 cs4 e4 a4 cs5 a4 e4 cs4]
  [g3 d4 a4 b4 d5 b4 a4 d4]
  [a3 e4 b4 cs5 e5 b4 a4 e4]
>`).s("roof_clean_soft").n("0 1 2 3 1 2 0 3")
  .clip(1.25).attack(0.001).release(0.55)
  .gain("0.18 0.13 0.15 0.17 0.18 0.13 0.16 0.14")
  .pan(0.23).hpf(110).lpf(6200).orbit(0)
  .delay(0.055).delaysync(3/16).delayfeedback(0.12)
  .room(0.10).roomsize(1.2);

const right = note(`<
  [~ a4 ~ e5 fs5 ~ e5 cs5]
  [~ e5 ~ cs5 e5 ~ a4 cs5]
  [~ d5 ~ fs5 a5 ~ fs5 d5]
  [~ e5 ~ b4 cs5 ~ b4 a4]
>`).s("roof_clean").n("2 0 3 1 0 2 1 3")
  .late(1/16).clip(1.05).attack(0.001).release(0.4)
  .gain(0.11).pan(0.77).hpf(160).lpf(6500).orbit(1)
  .delay(0.08).delaysync(3/16).delayfeedback(0.16)
  .room(0.14).roomsize(1.4);

const bass = note(`<
  [d2 ~ d2 a2 ~ d2 e2 fs2]
  [fs2 ~ fs2 cs3 ~ e2 fs2 ~]
  [g2 ~ g2 d3 ~ g2 fs2 e2]
  [a2 ~ e2 a2 ~ b2 a2 ~]
>`).s("gm_electric_bass_finger:1")
  .clip(0.92).attack(0.004).release(0.14)
  .gain(0.48).hpf(45).lpf(1800).pan(0.5).orbit(4);

// 从低弦到高弦错开约 7 毫秒，避免四个音像键盘一样同时落下。
const strumVoice = (notes, offset) =>
  note(notes).struct("x ~ ~ x ~ x ~ ~").late(offset);
const chords = stack(
  strumVoice("<d3 fs3 g3 a3>", 0),
  strumVoice("<fs3 a3 b3 b3>", 0.004),
  strumVoice("<a3 cs4 d4 e4>", 0.008),
  strumVoice("<e4 e4 a4 ~>", 0.012)
).s("roof_clean").n("<0 2 1 3>")
  .clip(1.3).attack(0.001).release(0.55).gain(0.075)
  .hpf(150).lpf(5200).pan(0.52).room(0.08).roomsize(1.1).orbit(3);

const lead = note(`<
  [a4 ~ fs4 e4 d4 ~ e4 fs4]
  [cs5 ~ b4 a4 gs4 a4 ~ e4]
  [b4 a4 fs4 ~ g4 a4 b4 d5]
  [cs5 b4 a4 e4 ~ fs4 e4 ~]
>`).s("roof_clean").n("1 3 0 2 3 1 2 0")
  .clip(1.1).attack(0.001).release(0.5).gain(0.15)
  .pan(0.60).hpf(130).lpf(5600).orbit(2)
  .delay(0.08).delaysync(1/8).delayfeedback(0.14)
  .room(0.12).roomsize(1.4);

// 同一套真鼓、同一支麦克风的录音。军鼓轻击使用独立的弱力度采样。
const kick = s("roof_kick ~ ~ [~ roof_kick] roof_kick ~ ~ roof_kick")
  .n("<0 1>").gain(1.8).lpf(5500);
const snare = s("~ ~ roof_snare ~ ~ ~ roof_snare ~")
  .n("<0 2 1 3>").gain(0.58).room(0.08).roomsize(0.8)
  .lastOf(4, p => stack(p,
    s("~ ~ ~ ~ ~ ~ ~ [roof_snare_soft roof_snare_soft]")
      .n("0 1").gain(0.6)));
const hats = s("roof_hh*8").n("0 2 1 3 2 0 3 1").cut(17)
  .gain("2.1 1.3 1.8 1.2 2.0 1.3 1.7 1.4")
  .pan(0.61).hpf(1800);
const drums = stack(kick, snare, hats).orbit(5);
const openHats = s("roof_hh roof_hh roof_hh roof_oh roof_hh roof_hh roof_hh roof_oh")
  .n("0 2 1 1 2 0 3 0").cut(17)
  .gain("2.1 1.3 1.8 2.0 2.0 1.3 1.7 2.0").pan(0.61).hpf(1800);
const fullDrums = stack(kick, snare, openHats).orbit(5);

// 36 小节，约 65 秒：独奏 → 合奏 → 展开 → 留白 → 合奏 → 收尾。
arrange(
  [4, left],
  [8, stack(left, right, bass, drums)],
  [8, stack(left, right, bass, chords, lead, fullDrums)],
  [4, stack(left.mul(gain(0.72)), right.mul(gain(0.65)))],
  [8, stack(left, right, bass, chords, lead, fullDrums)],
  [4, stack(left.mul(gain(0.65)), right.mul(gain(0.45)))]
).mul(gain(MASTER))
